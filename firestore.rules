// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Legacy voice logs collection
    match /voiceLogs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['input', 'userId', 'timestamp'])
        && request.resource.data.input is string
        && request.resource.data.input.size() <= 5000
        && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Strict user-scoped Financial Vault & Settings
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /financeLedger/{entryId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.bill is number
          && request.resource.data.total is number;
      }

      match /settings/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}